{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lobby Companion",
  "mainBinaryName": "lobby-companion",
  "version": "0.8.2",
  "identifier": "dev.nickmaglowsch.lobbycompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: lcu: http://lcu.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "nickmaglowsch",
    "copyright": "Copyright (c) 2026 nickmaglowsch. MIT License.",
    "shortDescription": "Runas, feitiços e conjuntos de itens do lolalytics na seleção de campeões",
    "homepage": "https://github.com/nickmaglowsch/lobby-companion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwMkYzQkYzOThGNzA5MzAKUldRd0NmZVk4enN2TUpJcmY5dmoxT0xRa1R4aElzeVp2aXdNTG9GUUgzTTNrOEROZWh3VzBjTGwK",
      "endpoints": [
        "https://github.com/nickmaglowsch/lobby-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
